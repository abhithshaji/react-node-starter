{
  "compilerOptions": {
    // File Layout
    "rootDir": "./",
    "outDir": "./dist",
    "removeComments": true,
    "forceConsistentCasingInFileNames": true,

    // Environment Settings
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022", // Targets native features of stable Node runtimes
    "lib": ["ES2022"],
    "types": ["node"],

    // Build Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Strictness Guardrails
    "strict": true, // Automatically includes strictNullChecks, noImplicitAny, etc.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Code Quality Checkers
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Compilation Performance & Interop
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // Paths
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@constant/*": ["./src/constant/*"],
      "@controller/*": ["./src/controller/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@model/*": ["./src/model/*"],
      "@router/*": ["./src/router/*"],
      "@services/*": ["./src/services/*"],
      "@appTypes/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@routes/*": ["./src/routes/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
