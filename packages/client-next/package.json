{
  "name": "client-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint:eslint-check": "eslint",
    "lint:eslint-fix": "eslint --fix",
    "lint:stylelint-check": "stylelint **/*.css",
    "lint:stylelint-fix": "stylelint **/*.css --fix",
    "dev": "dotenv -e .env.development -- sh -c 'next dev -p $CLIENT_PORT --turbopack'",
    "build": "next build --turbopack",
    "start": "dotenv -e .env.production -- sh -c 'next start -p $CLIENT_PORT'"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
